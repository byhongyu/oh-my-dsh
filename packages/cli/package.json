{
  "name": "oh-my-dsh",
  "version": "0.1.0",
  "description": "Curated agent presets for DeepSeek Harness (dsh)",
  "keywords": [
    "agent-presets",
    "ai-agents",
    "deepseek",
    "deepseek-harness",
    "developer-tools",
    "dsh",
    "dsh-plugin"
  ],
  "homepage": "https://github.com/byhongyu/oh-my-dsh#readme",
  "bugs": {
    "url": "https://github.com/byhongyu/oh-my-dsh/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/byhongyu/oh-my-dsh.git",
    "directory": "packages/cli"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "oh-my-dsh": "./dist/bin.cjs"
  },
  "files": [
    "dist/bin.cjs",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "tsc -b && esbuild src/bin.ts --bundle --platform=node --target=node24 --format=cjs --outfile=dist/bin.cjs",
    "bundle": "esbuild src/bin.ts --bundle --platform=node --target=node24 --format=cjs --outfile=dist/bin.cjs",
    "prepack": "tsc -b && esbuild src/bin.ts --bundle --platform=node --target=node24 --format=cjs --outfile=dist/bin.cjs",
    "typecheck": "tsc -b --pretty false"
  },
  "devDependencies": {
    "@oh-my-dsh/adapter-dsh-rc5": "workspace:*",
    "@oh-my-dsh/catalog": "workspace:*",
    "@oh-my-dsh/core": "workspace:*",
    "@oh-my-dsh/schema": "workspace:*"
  },
  "engines": {
    "node": ">=24"
  }
}
